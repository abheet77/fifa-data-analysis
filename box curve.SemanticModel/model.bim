        "measures": [
          {
            "name": "Total Tournaments",
            "expression": [
              "",
              "DISTINCTCOUNT('public vw_tournament_statistics'[tournament_id])"
            ],
            "formatString": "0",
            "lineageTag": "fe9b29d9-3a84-45df-a391-5c1738cdf616"
          },
          {
            "name": "Avg Goals Per Match",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "AVERAGE('public vw_tournament_statistics'[goals_per_match])"
            ],
            "lineageTag": "9bff74ef-a220-4b28-985d-d01c485dd6b3"
          },
          {
            "name": "Top Scorer Name",
            "expression": [
              "",
              "MAXX(",
              "    TOPN(",
              "        1,",
              "        'public vw_player_statistics',",
              "        [goals_scored],",
              "        DESC",
              "    ),",
              "    [player_name]",
              ")"
            ],
            "lineageTag": "95e701f1-2f11-46d4-a585-d259a995144b"
          },
          {
            "name": "Most Titles",
            "expression": [
              "",
              "MAX('public vw_team_statistics'[tournament_wins])"
            ],
            "formatString": "0",
            "lineageTag": "0c7557f0-98b9-4cb8-996a-59ff4281febe"
          },
          {
            "name": "Most Tournaments",
            "expression": "MAX('public vw_player_statistics'[count_tournaments])",
            "formatString": "0",
            "lineageTag": "c5e1dec0-1a5b-445f-9142-c8103f55cf7a"
          },
          {
            "name": "Win Percentage",
            "lineageTag": "b59a6165-9f3f-45d4-ae15-5316e3e361df"
          }
        ],
        "partitions": [
          {
            "name": "public vw_match_summary",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5432\", \"fifa_worldcup\"),",
                "    public_vw_match_summary = Source{[Schema=\"public\",Item=\"vw_match_summary\"]}[Data]",
                "in",
                "    public_vw_match_summary"
              ],
              "type": "m"
            }
